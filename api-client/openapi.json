		"/api/v1/posts": {
			"post": {
				"tags": [
					"v1"
				],
				"summary": "Create a post, exactly once",
				"description": "Idempotent per the IETF Idempotency-Key draft (mycocepurus-smithii): a retry with the same key replays the first response; the same key with a different body is 422; a concurrent duplicate is 409.",
				"security": [
					{
						"bearer": []
					}
				],
				"parameters": [
					{
						"name": "idempotency-key",
						"in": "header",
						"required": false,
						"schema": {
							"description": "Required. An RFC 8941 String: a quoted value, e.g. `\"3f1c...\"`. Retries must reuse it.",
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": [
									"title",
									"body"
								],
								"properties": {
