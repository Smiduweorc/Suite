		"/api/v1/auth/logout": {
			"post": {
				"tags": [
					"v1"
				],
				"summary": "End a session",
				"description": "Revokes the refresh token sent, so it can no longer be traded at /auth/refresh. Needs no access token: the refresh token is the credential. Idempotent: an already revoked, expired or unknown token gets the same 200, so a retry or a second sign-out is never an error. Ends this one session only; other devices stay signed in. Access tokens issued to this session stop working at once.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": [
									"refreshToken"
								],
								"properties": {
									"refreshToken": {
										"type": "string"
									}
								}
							}
						},
						"application/x-www-form-urlencoded": {
							"schema": {
								"type": "object",
								"required": [
									"refreshToken"
								],
								"properties": {
									"refreshToken": {
										"type": "string"
									}
								}
							}
						},
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"required": [
									"refreshToken"
								],
								"properties": {
									"refreshToken": {
										"type": "string"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Response for status 200",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": [
										"ok"
									],
									"properties": {
										"ok": {
											"const": true,
											"type": "boolean"
										}
									}
								}
							}
						}
					},
					"400": {
