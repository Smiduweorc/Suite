{
	"name": "@suite/api-client",
	"version": "1.0.0",
	"private": true,
	"description": "Typed client for the Suite REST API, generated by dung beetle from backend's OpenAPI document.",
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"generate": "bun tools/generator/cli.ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "tsc && node --test 'tests/dist/*.test.js'"
	},
	"devDependencies": {
		"@redocly/openapi-core": "^1.34.20",
		"@types/node": "^24.12.3",
		"@types/pluralize": "^0.0.33",
		"openapi-typescript": "^7.13.0",
		"pluralize": "^8.0.0"
	}
}
