# Bun loads this file automatically when it is named `.env`:
#   cp .env.example .env

NODE_ENV=development
# Elysia serves REST + tRPC here.
PORT=3000
# The gRPC server listens separately - gRPC needs HTTP/2, Elysia speaks HTTP/1.1.
GRPC_PORT=50051

# debug | info | warn | error | silent
# Pretty-printed while NODE_ENV=development, NDJSON otherwise (what a log shipper wants).
LOG_LEVEL=info
# Tags every log line, so one stream can carry more than one service.
SERVICE_NAME=bevd-lacewing-backend

# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgres://bevd:bevd@localhost:5432/bevd

# Also from ../docker-compose.yml. Holds the Repletes feed cache and the
# mycocepurus-smithii idempotency ledger - both disposable, neither persisted.
REDIS_URL=redis://localhost:6379

# Where the Vue dev server runs. The browser will not send credentials to an origin
# the server has not allowed.
CORS_ORIGIN=http://localhost:5173

# At least 32 characters, and lacewing entropy-checks it: a human-chosen passphrase
# will not start the app. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# How long an access token lives. Keep it short: it cannot be revoked before it
# expires. lacewing's syntax (30s, 15m, 1h) and its 1h cap: anything else refuses
# to boot.
JWT_ACCESS_EXPIRY=15m

# Pinned into (and checked against) every token. A token minted for another
# deployment fails verification here regardless of its signature.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000/trpc

# Refresh tokens are opaque, stored hashed and revocable, so this can be generous.
REFRESH_TOKEN_TTL_DAYS=7

# lax | strict. There is no "none" and no COOKIE_SECURE switch: every cookie is
# Secure, unconditionally (http://localhost counts as a secure context, so dev
# works; anything non-local must be https).
COOKIE_SAME_SITE=lax

# Empty leaves the cookies host-only, right on localhost and where one hostname serves
# both halves. Set the shared parent (COOKIE_DOMAIN=example.com) once the app and API
# are split across hosts: script on app.example.com cannot read the csrf_token cookie
# api.example.com scoped to itself, so every mutation fails CSRF. A Domain cookie also
# goes to every subdomain, including ones you do not run, and csrf_token is readable
# by script there too.
COOKIE_DOMAIN=
