{
	"name": "@bevd/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./trpc": "./src/trpc/routers/index.ts",
		"./policy": "./src/auth/policy.ts",
		"./email": "./src/auth/email.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun test --isolate --timeout 20000 --path-ignore-patterns='src/__integration__/**'",
		"test:integration": "bun test --isolate --timeout 20000 src/__integration__",
		"test:watch": "bun test --watch --path-ignore-patterns='src/__integration__/**'",
		"test:coverage": "bun test --isolate --coverage --path-ignore-patterns='src/__integration__/**'",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/db/seed.ts",
		"openapi": "bun run scripts/openapi.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.3",
		"@elysiajs/openapi": "^1.4.17",
		"@grpc/grpc-js": "^1.14.7",
		"@grpc/proto-loader": "^0.8.1",
		"@node-rs/argon2": "^2.2.2",
		"@trpc/server": "^11.29.7",
		"arktype": "^2.2.10",
		"cookie": "^2.0.2",
		"drizzle-orm": "^0.45.4",
		"elysia": "^1.4.32",
		"firefly-limiter": "^1.0.3",
		"ioredis": "^6.0.0",
		"lacewing": "^3.0.1",
		"mycocepurus-smithii": "^2.0.1",
		"pg": "^8.23.1",
		"phasmid": "^2.0.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"repletes": "^1.1.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.17",
		"@types/bun": "^1.4.5",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"ioredis-mock": "^8.13.1"
	}
}
