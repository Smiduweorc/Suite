# Expo inlines EXPO_PUBLIC_* at build time.   cp .env.example .env
#
# iOS simulator / web:   http://localhost:3000
# Android emulator:      http://10.0.2.2:3000  (the host machine, from inside the emulator)
# Physical device:       http://<your computer's LAN IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
