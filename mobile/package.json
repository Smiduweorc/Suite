{
	"name": "@suite/mobile",
	"version": "1.0.0",
	"main": "index.ts",
	"dependencies": {
		"@suite/api-client": "workspace:*",
		"expo": "~58.0.26",
		"expo-crypto": "~58.0.8",
		"expo-secure-store": "~58.0.3",
		"expo-status-bar": "~58.0.5",
		"firefly-limiter": "^1.0.3",
		"phasmid": "^2.0.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-native": "0.88.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-web": "^0.21.4"
	},
	"devDependencies": {
		"@types/react": "~19.3.0",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "bun run --cwd ../api-client build && expo start",
		"android": "bun run --cwd ../api-client build && expo start --android",
		"ios": "bun run --cwd ../api-client build && expo start --ios",
		"web": "bun run --cwd ../api-client build && expo start --web",
		"typecheck": "tsc --noEmit",
		"test": "bun test src"
	},
	"private": true,
	"description": "Expo app on the Suite API: generated dung beetle client, firefly retries, idempotent writes, phasmid on device."
}
