{
	"name": "suite",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "The Smiduweorc libraries as one suite: Bun + Elysia backend, Vue web client, Expo mobile app, Postgres + Redis.",
	"workspaces": [
		"backend",
		"frontend",
		"api-client",
		"mobile"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"mobile": "bun run --cwd mobile start",
		"build": "bun run --filter '*' build",
		"test": "bun run --filter '*' test",
		"test:integration": "bun run --cwd backend test:integration",
		"typecheck": "bun run client:build && bun run --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:push": "bun run --cwd backend db:push",
		"db:generate": "bun run --cwd backend db:generate",
		"db:migrate": "bun run --cwd backend db:migrate",
		"db:studio": "bun run --cwd backend db:studio",
		"db:seed": "bun run --cwd backend db:seed",
		"client:generate": "bun run --cwd backend openapi && bun run --cwd api-client generate && bun run client:build",
		"client:build": "bun run --cwd api-client build",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"lefthook": "^2.2.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
